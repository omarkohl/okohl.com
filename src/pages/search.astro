---
import Base from "../layouts/Base.astro";
import { STAGES, allNotes, topicsOf } from "../lib/notes";

// Topic names with their note counts, for the "topic match" banner.
const topics = Object.fromEntries(
  [...topicsOf(await allNotes())].map(([t, notes]) => [t, notes.length]),
);

const groups = [
  {
    name: "kind",
    options: [
      { value: "", label: "all" },
      { value: "note", label: "notes" },
      { value: "essay", label: "essays" },
    ],
  },
  {
    name: "stage",
    options: [
      { value: "", label: "all" },
      ...Object.entries(STAGES).map(([value, s]) => ({
        value,
        label: `${s.symbol} ${s.label.toLowerCase()}`,
      })),
    ],
  },
  {
    name: "sort",
    options: [
      { value: "", label: "relevance" },
      { value: "newest", label: "newest" },
    ],
  },
];
---

<Base title="Search" current="search">
  <form class="flex flex-col gap-3.5" role="search" action="/search/">
    <label for="q" class="smallcaps text-[15px] text-muted">
      search everything I have written
    </label>
    <div class="flex items-center gap-3 border-b-2 border-ink pb-1.5">
      <input
        id="q"
        name="q"
        type="search"
        autocomplete="off"
        autofocus
        class="min-w-0 flex-1 bg-transparent p-0 text-[28px] outline-none sm:text-4xl"
      />
      <span
        id="status"
        class="text-sm whitespace-nowrap text-muted italic"
        aria-live="polite"
      ></span>
    </div>
    <div class="flex flex-wrap items-baseline gap-x-7 gap-y-2 text-[15px]">
      {groups.map((g) => (
        <span class="option-group flex items-baseline gap-3">
          <span class="smallcaps text-muted">{g.name}</span>
          {g.options.map((o) => (
            <button
              type="button"
              data-name={g.name}
              data-value={o.value}
              class="cursor-pointer"
            >
              {o.label}
            </button>
          ))}
        </span>
      ))}
    </div>
    <p class="m-0 text-sm text-muted">
      <code>"exact phrase"</code> · <code>#topic</code> ·{" "}
      <code>stage:evergreen</code> · <code>date:2026</code> ·{" "}
      <code>date:2026-01..2026-06</code>
    </p>
  </form>

  <div
    id="topic-match"
    class="-mb-6 flex flex-col gap-2 empty:hidden"
    data-topics={JSON.stringify(topics)}
  ></div>

  <section id="results" class="flex flex-col gap-7" aria-label="Search results">
    <noscript>
      <p class="m-0 text-muted italic">
        Search needs JavaScript. Every note is also listed on the{" "}
        <a href="/notes/">notes</a> and
        <a href="/topics/">topics</a> pages.
      </p>
    </noscript>
  </section>
</Base>

<style>
  .option-group button[aria-pressed="true"] {
    font-weight: 600;
  }
  .option-group button[aria-pressed="false"] {
    text-decoration: underline;
    text-decoration-color: var(--color-underline);
    text-underline-offset: 3px;
  }
</style>

<script>
  import { inRange, parseQuery } from "../lib/query";

  type Result = {
    url: string;
    excerpt: string;
    meta: { title?: string; date?: string; day?: string; stage?: string };
    filters: { kind?: string[] };
  };
  type Pagefind = {
    init: () => Promise<void>;
    debouncedSearch: (
      q: string | null,
      opts?: {
        filters?: Record<string, string | string[]>;
        sort?: Record<string, "asc" | "desc">;
      },
      ms?: number,
    ) => Promise<{ results: { data: () => Promise<Result> }[] } | null>;
  };

  const input = document.querySelector<HTMLInputElement>("#q")!;
  const status = document.querySelector<HTMLElement>("#status")!;
  const results = document.querySelector<HTMLElement>("#results")!;
  const banner = document.querySelector<HTMLElement>("#topic-match")!;
  const topics: Record<string, number> = JSON.parse(banner.dataset.topics!);
  const buttons = [
    ...document.querySelectorAll<HTMLButtonElement>(".option-group button"),
  ];

  const params = new URLSearchParams(location.search);
  input.value = params.get("q") ?? "";
  // Options chosen with the buttons, by group name: kind, stage, sort.
  const chosen: Record<string, string> = {};
  for (const b of buttons)
    chosen[b.dataset.name!] ??= params.get(b.dataset.name!) ?? "";

  let pagefind: Pagefind | null = null;
  try {
    const path = "/pagefind/pagefind.js";
    pagefind = await import(/* @vite-ignore */ path);
    await pagefind!.init();
  } catch {
    status.textContent = "search index not built (run npm run build)";
  }

  function el<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    cls: string,
    text?: string,
  ) {
    const e = document.createElement(tag);
    e.className = cls;
    if (text) e.textContent = text;
    return e;
  }

  function render(items: Result[], total: number, ms: number) {
    status.textContent = `${total} result${total === 1 ? "" : "s"} · ${Math.round(ms)} ms`;
    results.replaceChildren(
      ...items.map((r) => {
        const art = el("article", "flex flex-col gap-1");
        const k = r.filters.kind?.[0] ?? "note";
        art.append(
          el(
            "span",
            "smallcaps text-[13px] text-muted",
            [k, r.meta.stage, r.meta.date].filter(Boolean).join(" · "),
          ),
        );
        const a = el(
          "a",
          "text-[22px] font-semibold no-underline",
          r.meta.title ?? r.url,
        );
        a.href = r.url;
        art.append(a);
        const p = el("p", "m-0 text-base text-ink-2");
        p.innerHTML = r.excerpt && `…${r.excerpt}…`; // Pagefind escapes content; only <mark> is added.
        art.append(p);
        return art;
      }),
    );
  }

  /** Points to the topic page when the query names a topic. */
  function renderTopics(names: string[]) {
    banner.replaceChildren(
      ...names
        .filter((t) => t in topics)
        .map((t) => {
          const n = topics[t];
          const a = el(
            "a",
            "border-l-2 border-accent bg-wash px-4 py-2 text-base no-underline",
          );
          a.href = `/topics/${t}/`;
          a.append(
            el("strong", "font-semibold", t),
            ` is a topic · ${n} note${n === 1 ? "" : "s"} →`,
          );
          return a;
        }),
    );
  }

  async function run() {
    buttons.forEach((b) =>
      b.setAttribute(
        "aria-pressed",
        String(b.dataset.value === chosen[b.dataset.name!]),
      ),
    );
    const q = input.value.trim();
    const url = new URL(location.href);
    url.searchParams.set("q", q);
    for (const [name, value] of Object.entries(chosen)) {
      if (value) url.searchParams.set(name, value);
      else url.searchParams.delete(name);
    }
    history.replaceState(null, "", url);

    const query = parseQuery(q);
    renderTopics([
      ...new Set([...query.topics, query.term.replace(/"/g, "").toLowerCase()]),
    ]);
    if (!pagefind) return;
    const filters: Record<string, string | string[]> = {};
    if (chosen.kind) filters.kind = chosen.kind;
    if (query.topics.length) filters.topic = query.topics;
    // A stage typed in the query is more specific than the button.
    const stage = query.stage ?? chosen.stage;
    if (stage) filters.stage = stage;
    const dated = Boolean(query.from || query.to);
    if (!query.term && !query.topics.length && !query.stage && !dated) {
      status.textContent = "";
      results.replaceChildren();
      return;
    }

    const t0 = performance.now();
    // Without a term, Pagefind returns every page that passes the filters.
    const search = await pagefind.debouncedSearch(
      query.term || null,
      { filters, ...(chosen.sort === "newest" && { sort: { date: "desc" } }) },
      150,
    );
    if (!search) return; // superseded by a newer query
    const found = search.results;
    if (dated) {
      // Pagefind has no range filter, so dates are compared here.
      const items = (await Promise.all(found.map((r) => r.data()))).filter(
        (r) => inRange(r.meta.day ?? "", query),
      );
      render(items.slice(0, 20), items.length, performance.now() - t0);
    } else {
      const items = await Promise.all(found.slice(0, 20).map((r) => r.data()));
      render(items, found.length, performance.now() - t0);
    }
  }

  input.addEventListener("input", run);
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      chosen[b.dataset.name!] = b.dataset.value ?? "";
      run();
    }),
  );
  run();
</script>
