---
import Base from "../../layouts/Base.astro";
import NoteList from "../../components/NoteList.astro";
import { allNotes, topicsOf, type Note } from "../../lib/notes";

export async function getStaticPaths() {
  return [...topicsOf(await allNotes())].map(([topic, notes]) => ({
    params: { topic },
    props: { notes },
  }));
}

const { topic } = Astro.params;
const { notes } = Astro.props as { notes: Note[] };
---

<Base title={topic} current="topics">
  <section class="flex flex-col gap-2">
    <h1 class="section-title m-0 mb-2">{topic}</h1>
    <NoteList notes={notes} />
  </section>
</Base>
