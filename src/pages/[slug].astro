---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import {
  STAGES,
  allNotes,
  backlinks,
  commitUrl,
  fmtLong,
  history,
  minutes,
  summary,
  tended,
  topicUrl,
  url,
  type Note,
} from "../lib/notes";
import { similar } from "../lib/similar";

export async function getStaticPaths() {
  const notes = await allNotes();
  return notes.map((note) => {
    const linkedFrom = backlinks(note, notes);
    // A note already listed under "Linked from" is not repeated as similar.
    const rest = notes.filter((n) => !linkedFrom.includes(n));
    return {
      params: { slug: note.id },
      props: { note, linkedFrom, related: similar(note, rest) },
    };
  });
}

const { note, linkedFrom, related } = Astro.props as {
  note: Note;
  linkedFrom: Note[];
  related: Note[];
};
const sections = [
  { heading: "Linked from", notes: linkedFrom },
  { heading: "Similar", notes: related },
].filter((s) => s.notes.length > 0);
const { Content } = await render(note);
const { title, kind, stage, planted, topics } = note.data;
const s = STAGES[stage];
const revs = history(note);
---

<Base
  title={title}
  description={summary(note)}
  article={{ published: planted, modified: tended(note), tags: topics }}
>
  <article class="flex max-w-[680px] min-w-0 flex-col gap-6" data-pagefind-body>
    <header class="relative flex flex-col gap-2.5">
      <h1 class="m-0 text-[40px] leading-tight font-semibold">{title}</h1>
      <p class="m-0 text-[15px] text-muted italic">
        <span>
          planted{" "}
          <time datetime={planted.toISOString()}>{fmtLong(planted)}</time>
        </span>
        {" · "}
        <span>
          last tended{" "}
          <time datetime={tended(note).toISOString()}>
            {fmtLong(tended(note))}
          </time>
        </span>
        {" · "}
        <span data-pagefind-filter="stage">
          {s.symbol} {s.label.toLowerCase()}
        </span>
        {topics.length > 0 && " · "}
        {topics.map((t, i) => (
          <>
            {i > 0 && ", "}
            <a href={topicUrl(t)} data-pagefind-filter="topic">
              {t}
            </a>
          </>
        ))}
        {" · "}
        <span>{minutes(note)} min</span>
      </p>
      <span hidden data-pagefind-filter="kind">
        {kind}
      </span>
      <span hidden data-pagefind-meta="date">
        {fmtLong(tended(note))}
      </span>
      <span hidden data-pagefind-meta="stage">
        {s.symbol} {s.label.toLowerCase()}
      </span>
      {revs.length > 0 && (
        <aside
          class="smallcaps flex flex-wrap gap-x-5 text-sm text-muted lg:absolute lg:top-3 lg:left-[712px] lg:w-[232px] lg:flex-col"
          data-pagefind-ignore
        >
          <a href="#history">
            history · {revs.length} revision{revs.length > 1 && "s"}
          </a>
        </aside>
      )}
    </header>

    <div class="prose max-w-none">
      <Content />
    </div>

    {sections.map((sec) => (
      <section
        class="mt-6 flex flex-col gap-3 border-t border-ink pt-4"
        data-pagefind-ignore
      >
        <h2 class="smallcaps m-0 text-lg font-semibold">{sec.heading}</h2>
        {sec.notes.map((n) => (
          <div class="text-base">
            <a href={url(n)} class="font-semibold">
              {n.data.title}
            </a>{" "}
            <span class="text-muted">· {n.data.kind}</span>
          </div>
        ))}
      </section>
    ))}

    {revs.length > 0 && (
      <section
        id="history"
        class="mt-6 flex flex-col gap-3 border-t border-ink pt-4"
        data-pagefind-ignore
      >
        <h2 class="smallcaps m-0 text-lg font-semibold">History</h2>
        <ol class="m-0 flex list-none flex-col gap-1.5 p-0 text-base">
          {revs.map((r) => (
            <li class="grid grid-cols-[104px_1fr] items-baseline gap-2">
              <time
                datetime={r.date.toISOString()}
                class="text-sm text-muted tabular-nums"
              >
                {fmtLong(r.date)}
              </time>
              <a href={commitUrl(r)}>{r.subject}</a>
            </li>
          ))}
        </ol>
      </section>
    )}
  </article>
</Base>
